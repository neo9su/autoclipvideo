# Remote GPU server deployment values. Fill this file on the GPU server only.
GPU_SERVICE_URL=http://127.0.0.1:8877
COMFYUI_URL=http://127.0.0.1:8188
WATCHDOG_URL=http://127.0.0.1:8878
GPU_EXECUTION_NODE=remote-gpu
# gpu-backend runs media workers; control-plane is UI/API-only.
DEPLOYMENT_ROLE=gpu-backend
REMOTE_BACKEND_URL=http://127.0.0.1:8899
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_DATA_DIR=./data
BACKEND_RECORDINGS_DIR=./recordings
# The path visible inside the container; keep host/SMB/Windows paths out of DB records.
STORAGE_DIR=/app/recordings
BACKEND_VOICE_DIR=./voice_output
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
MAX_CONCURRENT_CLIPS=1
MEM_WARN_GB=5
COSYVOICE_URL=
