# AutoClipVideo Environment Configuration
# Copy to .env and fill in your values

# GPU Service (Whisper transcription + NVENC encoding)
GPU_SERVICE_URL=http://10.190.0.203:8877
# Set on the GPU host before exposing job endpoints beyond the private network.
GPU_API_TOKEN=
RECLIP_REQUIRE_AUTH=1
COMFYUI_URL=http://10.190.0.203:8188
WATCHDOG_URL=http://10.190.0.203:8877

# AWS Bedrock (AI analysis + script generation)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Performance tuning
MAX_CONCURRENT_CLIPS=1
MEM_WARN_GB=5

# CosyVoice2 TTS (optional, uses GPU service built-in if empty)
COSYVOICE_URL=
TRANSCRIBE_TIMEOUT_SECONDS=900
TTS_TIMEOUT_SECONDS=1800
# Minimum free space retained on the GPU storage volume before rejecting uploads.
DISK_MIN_FREE_GB=10
# Additional free-space reserve required beyond a known upload size.
DISK_UPLOAD_RESERVE_GB=1
